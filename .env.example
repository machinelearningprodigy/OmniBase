# ─── OmniBase Environment Configuration ────────────────────────────────────────
# Copy this file to .env and fill in the values
# cp .env.example .env

# ─── Environment ──────────────────────────────────────────────────────────────
OMNIBASE_ENV=development
LOG_LEVEL=debug

# ─── Gateway ──────────────────────────────────────────────────────────────────
GATEWAY_PORT=8000
RATE_LIMIT_RPS=1000

# ─── Security ───────────────────────────────────────────────────────────────── 
# IMPORTANT: Change these in production! Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=720h

# Anonymous key (JWT with role=anon, no expiry) — generate with: omnibase gen keys
ANON_KEY=

# Service role key (JWT with role=service_role) — KEEP SECRET, never expose client-side
SERVICE_ROLE_KEY=

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=omnibase
POSTGRES_PASSWORD=omnibase_dev_password
POSTGRES_DB=omnibase
POSTGRES_SSL_MODE=disable

# ─── Auth Service ──────────────────────────────────────────────────────────────
AUTH_PORT=9001
SITE_URL=http://localhost:3001
API_EXTERNAL_URL=http://localhost:8000

# Email (leave empty to disable email sending in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=OmniBase
SMTP_SENDER_EMAIL=noreply@omnibase.dev

# OAuth Providers (optional — leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Storage Service ───────────────────────────────────────────────────────────
STORAGE_PORT=9003
STORAGE_BACKEND=minio
MAX_UPLOAD_SIZE_MB=50

# MinIO (S3-compatible storage backend)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=omnibase-minio
MINIO_SECRET_KEY=omnibase-minio-secret
MINIO_BUCKET=omnibase-storage
MINIO_USE_SSL=false

# ─── Realtime Service ──────────────────────────────────────────────────────────
REALTIME_PORT=9004
REPLICATION_SLOT=omnibase_realtime
REPLICATION_PUBLISHER=omnibase_publication

# ─── Cache (Valkey/Redis) ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── NATS JetStream ────────────────────────────────────────────────────────────
NATS_URL=nats://localhost:4222

# ─── Database Meta ─────────────────────────────────────────────────────────────
DATABASE_META_PORT=9005
POSTGREST_URL=http://localhost:3000

# PostgREST config
PGRST_DB_SCHEMAS=public
PGRST_DB_EXTRA_SEARCH_PATH=public

# ─── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_PORT=3001
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin

# ─── Observability ─────────────────────────────────────────────────────────────
# Uncomment to enable OpenTelemetry tracing
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=omnibase

# ─── Phase 2+ (Functions) ──────────────────────────────────────────────────────
# These are not used in Phase 1 but included for easy setup
# FUNCTIONS_PORT=9006
# WASMTIME_CACHE_DIR=./data/wasm-cache

# ─── Phase 4+ (AI Features) ────────────────────────────────────────────────────
# OPENAI_API_KEY=
# COHERE_API_KEY=
# OLLAMA_URL=http://localhost:11434
